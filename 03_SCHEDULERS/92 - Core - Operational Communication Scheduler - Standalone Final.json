      "id": "0ec70276-873d-46e6-8a58-80bd0b1f4eb6",
      "name": "Webhook - Run Operational Scheduler"
    },
    {
      "parameters": {
        "jsCode": "const input=$json.body??$json;\nconst text=v=>v===null||v===undefined?'':String(v).trim();\nconst bool=v=>typeof v==='boolean'?v:['true','1','yes','on'].includes(text(v).toLowerCase());\n\nconst clinic_name=text(input.clinic_name);\nconst channel=text(input.channel||'whatsapp').toLowerCase();\nconst dispatch_batch_size=Number(input.dispatch_batch_size??100);\nconst webhook_base_url=text(input.webhook_base_url||'http://localhost:5678/webhook').replace(/\\/+$/,'');\nconst confirm_run=bool(input.confirm_run);\n\nconst errors=[];\nif(!['whatsapp','sms','email','phone','web_push','in_app'].includes(channel)){\n  errors.push({field:'channel',message:'کانال معتبر نیست.'});\n}\nif(!Number.isInteger(dispatch_batch_size)||dispatch_batch_size<1||dispatch_batch_size>500){\n  errors.push({field:'dispatch_batch_size',message:'Batch باید بین 1 و 500 باشد.'});\n}\nif(!/^https?:\\/\\/.+/i.test(webhook_base_url)){\n  errors.push({field:'webhook_base_url',message:'آدرس Webhook معتبر نیست.'});\n}\nif(confirm_run!==true){\n  errors.push({field:'confirm_run',message:'اجرای Scheduler باید تأیید شود.'});\n}\n\nreturn [{json:{\n  clinic_name,channel,dispatch_batch_size,webhook_base_url,confirm_run,\n  validation_status:errors.length?'invalid':'valid',errors\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
