      "name": "Run Retry Maintenance",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const scheduler=$('Collapse Dispatch Results').first().json;\nreturn [{json:{\n  success:scheduler.success&&$json.success!==false,\n  result:'operational_communication_scheduler_completed',\n  task_count:scheduler.task_count,\n  failed_task_count:scheduler.failed_task_count,\n  task_counts_by_type:scheduler.task_counts_by_type,\n  dispatch_result_count:scheduler.dispatch_result_count,\n  retry_maintenance_result:$json.result||null,\n  released_stuck_count:$json.released_stuck_count??0,\n  requeued_count:$json.requeued_count??0,\n  dead_lettered_count:$json.dead_lettered_count??0,\n  unresolved_dead_letter_count:$json.unresolved_dead_letter_count??0\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
