      "name": "Is Scheduler Run Valid?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH request_data AS (\n    SELECT NULLIF($1::TEXT, '') AS clinic_name\n)\nSELECT\n    COALESCE(\n        JSONB_AGG(\n            JSONB_BUILD_OBJECT(\n                'clinic_id',\n                    clinic.id,\n                'clinic_name',\n                    clinic.name,\n                'timezone',\n                    clinic.timezone\n            )\n            ORDER BY clinic.id\n        ),\n        '[]'::JSONB\n    ) AS clinics\nFROM clinics clinic\nCROSS JOIN request_data request\nWHERE clinic.is_active = TRUE\n  AND (\n        request.clinic_name IS NULL\n        OR clinic.name = request.clinic_name\n      );",
        "options": {
          "queryReplacement": "={{ [ $json.clinic_name ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -532,
        -48
      ],
      "id": "ed9045c9-a822-41d6-bd48-95b497f4e0d8",
      "name": "Load Active Clinics"
    },
    {
      "parameters": {
        "jsCode": "const config=$('Normalize and Validate Scheduler Run').first().json;\nconst clinics=Array.isArray($json.clinics)?$json.clinics:[];\n\nif(!clinics.length){\n  return [{json:{\n    has_task:false,\n    task_type:'none',\n    result:'no_active_clinics',\n    clinic_count:0,\n    webhook_base_url:config.webhook_base_url,\n    dispatch_batch_size:config.dispatch_batch_size\n  }}];\n}\n\nconst tasks=[];\n\nfor(const clinic of clinics){\n  const common={\n    clinic_name:clinic.clinic_name,\n    webhook_base_url:config.webhook_base_url,\n    confirm_run:true\n  };\n\n  tasks.push({\n    task_type:'appointment_confirmations',\n    clinic_name:clinic.clinic_name,\n    url:`${config.webhook_base_url}/clinic/communications/appointment-confirmations/generate-and-queue`,\n    payload:{\n      ...common,\n      window_start_hours:20,\n      window_end_hours:28,\n      response_deadline_hours:12,\n      channel:config.channel,\n      limit:200\n    }\n  });\n\n  tasks.push({\n    task_type:'post_visit_followups',\n    clinic_name:clinic.clinic_name,\n    url:`${config.webhook_base_url}/clinic/communications/post-visit/generate-and-queue`,\n    payload:{\n      ...common,\n      followup_stage:'first_day',\n      visit_end_min_hours_ago:18,\n      visit_end_max_hours_ago:30,\n      response_deadline_hours:24,\n      channel:config.channel,\n      limit:200\n    }\n  });\n\n  tasks.push({\n    task_type:'unanswered_confirmation_escalation',\n    clinic_name:clinic.clinic_name,\n    url:`${config.webhook_base_url}/clinic/appointments/escalate-unanswered-confirmations`,\n    payload:{\n      clinic_name:clinic.clinic_name,\n      lookback_hours:72,\n      future_window_hours:48,\n      limit:200,\n      confirm_escalation:true\n    }\n  });\n}\n\nreturn tasks.map(task=>({json:{\n  ...task,\n  has_task:true,\n  clinic_count:clinics.length,\n  webhook_base_url:config.webhook_base_url,\n  dispatch_batch_size:config.dispatch_batch_size\n}}));"
      },
