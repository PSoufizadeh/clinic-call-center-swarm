    {
      "parameters": {
        "jsCode": "const task=$('Build Scheduler Tasks').item.json;\nreturn [{json:{\n  task_type:task.task_type,\n  clinic_name:task.clinic_name,\n  success:$json.success!==false,\n  result:$json.result||'task_completed',\n  raw_result:$json\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        492,
        -144
      ],
      "id": "68c17a83-8fe1-4ce9-ba83-5abc6bad2851",
      "name": "Normalize Operational Task Result"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.all().map(item=>item.json);\nconst config=$('Normalize and Validate Scheduler Run').first().json;\n\nconst failed=items.filter(item=>item.success===false);\nconst byType={};\n\nfor(const item of items){\n  byType[item.task_type]=(byType[item.task_type]||0)+1;\n}\n\nreturn [{json:{\n  success:failed.length===0,\n  result:failed.length?'scheduler_tasks_completed_with_errors':'scheduler_tasks_completed',\n  task_count:items.length,\n  failed_task_count:failed.length,\n  task_counts_by_type:byType,\n  task_results:items,\n  webhook_base_url:config.webhook_base_url,\n  dispatch_batch_size:config.dispatch_batch_size,\n  dispatch_url:`${config.webhook_base_url}/clinic/communications/messages/dispatch`,\n  maintenance_url:`${config.webhook_base_url}/clinic/communications/messages/retry-maintenance`\n}}];"
      },
