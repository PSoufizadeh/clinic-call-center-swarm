      "id": "2bae562d-043e-4abe-8608-59601fd8aa72",
      "name": "Execute Maintenance Task",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task =\n  $('Build Platform Maintenance Tasks')\n    .item.json;\n\nconst response = $json ?? {};\n\nreturn [{\n  json: {\n    task_type: task.task_type,\n    success:\n      response.success !== false,\n    result:\n      response.result || 'maintenance_task_completed',\n    response,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        476,
        -144
      ],
      "id": "a698c6e9-168c-439e-af31-f423b1389d1a",
      "name": "Normalize Maintenance Task Result"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input\n  .all()\n  .map((item) => item.json);\n\nconst failed = results.filter(\n  (item) => item.success === false\n);\n\nreturn [{\n  json: {\n    success: failed.length === 0,\n    result:\n      failed.length === 0\n        ? 'platform_maintenance_completed'\n        : 'platform_maintenance_completed_with_errors',\n    task_count: results.length,\n    failed_task_count: failed.length,\n    task_results: results,\n    completed_at: new Date().toISOString(),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        732,
        -48
      ],
      "id": "cc9bc25f-9ff0-47df-a1c7-dc8c7ff4c426",
