      "id": "ae9d810d-8396-40d8-a869-f029d9aeb97f",
      "name": "Webhook - Run Platform Maintenance"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\n\nconst text = (value) =>\n  value === null || value === undefined\n    ? ''\n    : String(value).trim();\n\nconst bool = (value) =>\n  typeof value === 'boolean'\n    ? value\n    : ['true', '1', 'yes', 'on'].includes(\n        text(value).toLowerCase()\n      );\n\nconst mode = text(input.mode || 'auto').toLowerCase();\nconst clinic_name = text(input.clinic_name);\nconst timezone =\n  text(input.timezone || 'Asia/Baghdad');\nconst cleanup_hour = Number(input.cleanup_hour ?? 3);\nconst force_cleanup = bool(input.force_cleanup);\nconst webhook_base_url =\n  text(\n    input.webhook_base_url ||\n    'http://localhost:5678/webhook'\n  ).replace(/\\/+$/, '');\nconst confirm_run = bool(input.confirm_run);\n\nconst errors = [];\n\nif (!['auto', 'hourly', 'daily', 'all'].includes(mode)) {\n  errors.push({\n    field: 'mode',\n    message: 'حالت Scheduler معتبر نیست.',\n  });\n}\n\ntry {\n  new Intl.DateTimeFormat(\n    'en-US',\n    { timeZone: timezone }\n  ).format(new Date());\n} catch {\n  errors.push({\n    field: 'timezone',\n    message: 'منطقه زمانی معتبر نیست.',\n  });\n}\n\nif (\n  !Number.isInteger(cleanup_hour) ||\n  cleanup_hour < 0 ||\n  cleanup_hour > 23\n) {\n  errors.push({\n    field: 'cleanup_hour',\n    message: 'ساعت Cleanup باید بین صفر و 23 باشد.',\n  });\n}\n\nif (!/^https?:\\/\\/.+/i.test(webhook_base_url)) {\n  errors.push({\n    field: 'webhook_base_url',\n    message: 'آدرس Webhook معتبر نیست.',\n  });\n}\n\nif (confirm_run !== true) {\n  errors.push({\n    field: 'confirm_run',\n    message: 'اجرای Scheduler باید تأیید شود.',\n  });\n}\n\nreturn [{\n  json: {\n    mode,\n    clinic_name,\n    timezone,\n    cleanup_hour,\n    force_cleanup,\n    webhook_base_url,\n    confirm_run,\n    validation_status:\n      errors.length === 0 ? 'valid' : 'invalid',\n    errors,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -788,
        48
      ],
      "id": "4907b0fb-59b4-4a8e-8aa8-e9989d9d8359",
      "name": "Normalize and Validate Maintenance Run"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "282117da-4645-49d3-b3de-541b78b99660",
              "leftValue": "={{ $json.validation_status }}",
              "rightValue": "valid",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -548,
        48
      ],
      "id": "02dd66a4-d197-43ca-a9e5-291b15800052",
      "name": "Is Maintenance Run Valid?"
    },
    {
      "parameters": {
        "jsCode": "const config = $json;\n\nconst hourParts = new Intl.DateTimeFormat(\n  'en-US',\n  {\n    timeZone: config.timezone,\n    hour: '2-digit',\n    hourCycle: 'h23',\n  }\n).formatToParts(new Date());\n\nconst localHour = Number(\n  hourParts.find(\n    (part) => part.type === 'hour'\n  )?.value || 0\n);\n\nconst shouldCleanup =\n  config.force_cleanup === true ||\n  config.mode === 'daily' ||\n  config.mode === 'all' ||\n  (\n    config.mode === 'auto' &&\n    localHour === config.cleanup_hour\n  );\n\nconst tasks = [];\n\nif (\n  ['auto', 'hourly', 'all'].includes(\n    config.mode\n  )\n) {\n  tasks.push({\n    task_type: 'system_health_check',\n    url:\n      `${config.webhook_base_url}/clinic/operations/health/check`,\n    payload: {\n      clinic_name: config.clinic_name,\n      warning_queue_threshold: 100,\n      critical_queue_threshold: 500,\n      stale_processing_minutes: 15,\n      error_window_hours: 24,\n      confirm_check: true,\n    },\n  });\n\n  tasks.push({\n    task_type: 'message_retry_maintenance',\n    url:\n      `${config.webhook_base_url}/clinic/communications/messages/retry-maintenance`,\n    payload: {\n      stuck_processing_minutes: 15,\n      retry_batch_size: 500,\n      confirm_maintenance: true,\n    },\n  });\n}\n\nif (shouldCleanup) {\n  tasks.push({\n    task_type: 'data_retention_cleanup',\n    url:\n      `${config.webhook_base_url}/clinic/operations/maintenance/cleanup`,\n    payload: {\n      dry_run: false,\n      batch_size: 5000,\n      permission_check_retention_days: 90,\n      delivery_event_retention_days: 180,\n      message_attempt_retention_days: 180,\n      audit_retention_days: 365,\n      resolved_error_retention_days: 180,\n      health_snapshot_retention_days: 90,\n      maintenance_run_retention_days: 90,\n      confirm_cleanup: true,\n    },\n  });\n}\n\nif (tasks.length === 0) {\n  return [{\n    json: {\n      has_task: false,\n      task_type: 'none',\n      result: 'no_maintenance_task_for_mode',\n      local_hour: localHour,\n      should_cleanup: shouldCleanup,\n    },\n  }];\n}\n\nreturn tasks.map((task) => ({\n  json: {\n    ...task,\n    has_task: true,\n    local_hour: localHour,\n    should_cleanup: shouldCleanup,\n    mode: config.mode,\n  },\n}));"
      },
