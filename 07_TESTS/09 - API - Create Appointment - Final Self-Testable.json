    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\n\nconst text = (value) => {\n  if (value === null || value === undefined) return '';\n  return String(value).trim();\n};\n\nconst data = {\n  clinic_name: text(input.clinic_name),\n  doctor_name: text(input.doctor_name),\n  service_name: text(input.service_name),\n  patient_name: text(input.patient_name),\n  mobile: text(input.mobile),\n  target_date: text(input.target_date),\n  start_time: text(input.start_time),\n  visit_reason: text(input.visit_reason),\n};\n\nconst errors = [];\n\nconst required = [\n  ['clinic_name', 'نام کلینیک الزامی است.'],\n  ['doctor_name', 'نام پزشک الزامی است.'],\n  ['service_name', 'نام خدمت الزامی است.'],\n  ['patient_name', 'نام بیمار الزامی است.'],\n  ['mobile', 'شماره موبایل الزامی است.'],\n  ['target_date', 'تاریخ نوبت الزامی است.'],\n  ['start_time', 'ساعت نوبت الزامی است.'],\n];\n\nfor (const [field, message] of required) {\n  if (!data[field]) errors.push({ field, message });\n}\n\nfunction isRealIsoDate(value) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n\n  const [year, month, day] = value.split('-').map(Number);\n  const date = new Date(Date.UTC(year, month - 1, day));\n\n  return (\n    date.getUTCFullYear() === year &&\n    date.getUTCMonth() === month - 1 &&\n    date.getUTCDate() === day\n  );\n}\n\nif (data.target_date && !isRealIsoDate(data.target_date)) {\n  errors.push({\n    field: 'target_date',\n    message: 'تاریخ باید معتبر و با قالب YYYY-MM-DD باشد.',\n  });\n}\n\nif (data.start_time && !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(data.start_time)) {\n  errors.push({\n    field: 'start_time',\n    message: 'ساعت باید با قالب HH:MM باشد.',\n  });\n}\n\nif (data.mobile && !/^\\+?[0-9]{8,15}$/.test(data.mobile)) {\n  errors.push({\n    field: 'mobile',\n    message: 'شماره موبایل باید فقط شامل اعداد و در صورت نیاز علامت + باشد.',\n  });\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      validation_status: errors.length === 0 ? 'valid' : 'invalid',\n      errors,\n    },\n  },\n];"
      },
